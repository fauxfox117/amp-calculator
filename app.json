{
  "expo": {
    "name": "Amp Calculator",
    "slug": "Amp-calculator",
    "scheme": "Amp-calculator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./Assets/images/TL_SQUARE.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./Assets/images/TL-Splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stevenabolin.Ampcalculator"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./Assets/images/TL_SQUARE.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.stevenabolin.Ampcalculator"
    },
    "web": {
      "favicon": "./Assets/images/TL-favicon.png"
    },
    "plugins": ["expo-router", "expo-web-browser"]
  }
}
